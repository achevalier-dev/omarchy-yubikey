#!/bin/bash
# yubikey-menu — YubiKey actions for the Omarchy menu.
#
# Wired up from ~/.config/omarchy/extensions/omarchy-menu.jsonc. Anything that
# needs a PIN, a password, or a long readout opens a floating terminal; the
# rest reports back through Omarchy notifications.
#
# CCID applications (OATH, PIV, OpenPGP) need the pcscd socket running.
# FIDO and OTP talk over raw HID and work without it.

set -uo pipefail

GLYPH=""
CLIPBOARD_TIMEOUT=30

notify() { omarchy-notification-send -g "$GLYPH" "YubiKey" "$1"; }
fail() {
  notify "$1"
  exit 1
}

terminal() { omarchy-launch-floating-terminal-with-presentation "$@"; }

require_ykman() { command -v ykman >/dev/null || fail "ykman is not installed"; }

# Yubico's USB vendor id is 1050. Reading sysfs answers "is it plugged in" in
# microseconds, which is what menu guards and the bar need — ykman takes half a
# second and is saved for questions only it can answer.
key_present() {
  local id
  for id in /sys/bus/usb/devices/*/idVendor; do
    [[ -r $id && $(<"$id") == 1050 ]] && return 0
  done
  return 1
}

# Presence comes from sysfs in about eight milliseconds; `ykman list` needs a
# second and a third of it, which is a long time to stare at nothing.
require_key() {
  key_present && return 0
  systemctl is-active --quiet pcscd.socket ||
    fail "Smart card daemon is not running — enable it from the YubiKey menu"
  fail "No YubiKey detected — insert your key and try again"
}

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/yubikey-menu"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yubikey-menu"

# The account list changes when you enrol something, which is rare, so the
# picker draws from a cache and the key is asked again in the background.
refresh_cache() {
  local list serial
  list=$(timeout 20 ykman oath accounts list 2>/dev/null) || return 1
  [[ -n $list ]] || return 1
  mkdir -p "$CACHE_DIR"
  printf '%s\n' "$list" >"$CACHE_DIR/accounts.tmp" && mv "$CACHE_DIR/accounts.tmp" "$CACHE_DIR/accounts"
  serial=$(timeout 20 ykman list --serials 2>/dev/null | head -n1) &&
    [[ -n $serial ]] && printf '%s\n' "$serial" >"$CACHE_DIR/serial"
  return 0
}

refresh_cache_detached() { (refresh_cache >/dev/null 2>&1 &) ; }

# Which account you picked last time you were looking at this, so three
# accounts from the same provider do not all look equally likely.
remember_choice() { # $1: context key, $2: account
  [[ -n $1 && -n $2 ]] || return 0
  mkdir -p "$STATE_DIR"
  local file="$STATE_DIR/choices" tmp
  tmp=$(mktemp)
  {
    printf '%s\t%s\n' "$1" "$2"
    [[ -r $file ]] && grep -vF "$(printf '%s\t' "$1")" "$file" | head -n 200
  } >"$tmp" 2>/dev/null
  mv "$tmp" "$file"
  chmod 600 "$file"
}

recall_choice() { # $1: context key
  local file="$STATE_DIR/choices"
  [[ -n $1 && -r $file ]] || return 1
  awk -F'\t' -v key="$1" '$1 == key { print $2; exit }' "$file"
}

pick() { # $1: rows, $2: prompt
  local rows=$1 prompt=$2
  [[ -n $rows ]] || return 1
  printf '%s\n' "$rows" | omarchy-menu-select "$prompt"
}

label_of() { printf '%s' "${1%%$'\t'*}"; }


# ── Adding accounts ──────────────────────────────────────────────────────────
# The secret goes to ykman on stdin, never as an argument, so it stays out of
# the process list and out of shell history.

urldecode() { printf '%b' "${1//%/\\x}"; }

# Reads one field out of an otpauth:// query string.
uri_param() { # $1: uri, $2: key
  local rest=${1#*\?}
  local pair
  while IFS= read -r pair; do
    [[ ${pair%%=*} == "$2" ]] || continue
    urldecode "${pair#*=}"
    return 0
  done < <(tr '&' '\n' <<<"$rest")
  return 1
}

add_from_uri() { # $1: otpauth:// URI
  local uri=$1
  [[ $uri == otpauth://* ]] || fail "That is not an otpauth:// setup code"

  local kind label secret issuer digits period algorithm
  kind=${uri#otpauth://}
  kind=${kind%%/*}
  label=${uri#otpauth://*/}
  label=${label%%\?*}
  label=$(urldecode "$label")

  secret=$(uri_param "$uri" secret) || fail "That setup code carries no secret"
  issuer=$(uri_param "$uri" issuer || true)
  digits=$(uri_param "$uri" digits || true)
  period=$(uri_param "$uri" period || true)
  algorithm=$(uri_param "$uri" algorithm || true)

  if timeout 20 ykman oath accounts list 2>/dev/null | grep -qxF "$label"; then
    fail "$label is already on this key — remove it first if you mean to replace it"
  fi

  local args=(oath accounts add)
  [[ $kind == hotp ]] && args+=(--oath-type hotp)
  [[ -n ${issuer:-} && $label != *:* ]] && args+=(--issuer "$issuer")
  [[ -n ${digits:-} ]] && args+=(--digits "$digits")
  [[ -n ${period:-} ]] && args+=(--period "$period")
  [[ -n ${algorithm:-} ]] && args+=(--algorithm "$(tr '[:upper:]' '[:lower:]' <<<"$algorithm")")
  args+=(-f "$label")

  local output
  if ! output=$(printf '%s' "$secret" | timeout 30 ykman "${args[@]}" 2>&1); then
    fail "Could not add $label: $(head -n1 <<<"$output")"
  fi
  refresh_cache >/dev/null 2>&1 || true
  notify "Added $label to your YubiKey"
}

# ── Context matching ─────────────────────────────────────────────────────────
# The focused window is the best hint about which account you want. Login pages
# almost always name the service ("Sign in to GitHub · GitHub"), and native apps
# name it in the window class. Matches are floated to the top of the picker and
# nothing is ever picked for you.

STOPWORDS=" com www net org co uk io app the and for your new tab page home sign login log account accounts secure security verify verification two factor authentication authenticator browser brave chrome chromium firefox mozilla zen window private "

# The focused window, read once. Every signal below comes out of this one
# hyprctl call — three separate ones cost more than everything else here.
WINDOW_CLASS=""
WINDOW_TEXT=""
read_window() {
  [[ -z $WINDOW_TEXT ]] || return 0
  # One hyprctl and one jq for all three signals below.
  local line
  line=$(hyprctl activewindow -j 2>/dev/null |
    jq -r '((.class // "") + "\t" + ((.class // "") + " " + (.title // ""))) | ascii_downcase' 2>/dev/null)
  WINDOW_CLASS=${line%%$'\t'*}
  WINDOW_TEXT=${line#*$'\t'}
  [[ -n $WINDOW_TEXT ]] || WINDOW_TEXT=" "
}

# Lowercased words from the focused window, minus browser chrome and noise.
CONTEXT_TOKENS=""
context_tokens() {
  if [[ -z $CONTEXT_TOKENS ]]; then
    local text own_host own_user word out=""
    read_window
    text=$WINDOW_TEXT
    # Hoisted: these were being recomputed for every single word.
    own_host=${HOSTNAME:-$(hostname 2>/dev/null)}
    own_host=${own_host,,}
    own_user=${USER:-$(id -un)}
    own_user=${own_user,,}

    while IFS= read -r word; do
      ((${#word} >= 3)) || continue
      [[ $STOPWORDS == *" $word "* ]] && continue
      [[ $word == "$own_host" || $word == "$own_user" ]] && continue
      out+="$word"$'\n'
    done < <(tr -cs '[:alnum:]' '\n' <<<"$text" | sort -u)
    CONTEXT_TOKENS=$out
  fi
  printf '%s' "$CONTEXT_TOKENS"
}

# Addresses shown in the focused window — a Google or AWS sign-in page names
# the account you are signing into, which is the difference between three
# identical-looking entries.
context_emails() {
  read_window
  grep -oE '[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}' <<<"$WINDOW_TEXT" | sort -u
}

# A stable key for "what am I looking at", used to remember the choice.
context_key() {
  local token
  read_window
  token=$(context_tokens | head -n1)
  printf '%s/%s' "${WINDOW_CLASS:-none}" "${token:-none}"
}

# Prints "score<TAB>account" for each account on stdin.
rank_accounts() {
  local -a tokens=() emails=()
  mapfile -t tokens < <(context_tokens)
  mapfile -t emails < <(context_emails)
  local remembered
  remembered=$(recall_choice "$(context_key)" || true)

  local account lower score token email
  while IFS= read -r account; do
    [[ -n $account ]] || continue
    lower=${account,,}
    score=0
    for token in "${tokens[@]}"; do
      [[ -n $token && $lower == *"$token"* ]] || continue
      ((score += ${#token} >= 5 ? 60 : 30))
    done
    for email in "${emails[@]}"; do
      [[ -n $email && $lower == *"$email"* ]] && ((score += 150))
    done
    # Only a tiebreak: it lifts one of several matches, it does not invent one.
    [[ -n $remembered && $account == "$remembered" && $score -gt 0 ]] && ((score += 100))
    printf '%s\t%s\n' "$score" "$account"
  done
}

# Short label for what we matched against, e.g. "brave-browser".
context_label() {
  hyprctl activewindow -j 2>/dev/null | jq -r '.class // ""'
}

# Picks an account and prints "<code>\t<account>". Ranked rows, matches first.
pick_code() { # $1: account to use directly, or empty to draw the picker
  local wanted=${1:-}
  local accounts rows label

  # A cached list draws the picker immediately; the key is re-read afterwards
  # so an account enrolled elsewhere shows up next time.
  if [[ -z $wanted && -s "$CACHE_DIR/accounts" ]]; then
    accounts=$(<"$CACHE_DIR/accounts")
    refresh_cache_detached
  elif ! accounts=$(timeout 20 ykman oath accounts list 2>&1); then
    if grep -qi 'password' <<<"$accounts"; then
      notify "OATH is password protected — unlock it in the terminal"
      terminal 'ykman oath accounts code'
      exit 0
    fi
    fail "Could not read OATH accounts: $(head -n1 <<<"$accounts")"
  fi
  [[ -n $accounts ]] || fail "This YubiKey has no OATH accounts stored"
  [[ -s "$CACHE_DIR/accounts" ]] || refresh_cache_detached

  label=$(context_label)
  rows=$(rank_accounts <<<"$accounts" | sort -s -rn -k1,1 | while IFS=$'\t' read -r score account; do
    if ((score > 0)); then
      printf '%s\t%s\t%s\n' "$GLYPH" "$account" "matches this window"
    else
      printf '%s\t%s\n' "$GLYPH" "$account"
    fi
  done)

  local selection account
  if [[ -n $wanted ]]; then
    account=$wanted
  else
    selection=$(printf '%s\n' "$rows" | omarchy-menu-select "Search accounts") || return 1
    account=$(label_of "$selection")
  fi

  [[ -n $wanted ]] || remember_choice "$(context_key)" "$account"
  notify "Fetching a code for $account — touch your key if it blinks"

  local code
  if ! code=$(timeout 30 ykman oath accounts code --single "$account" 2>&1) || [[ -z $code ]]; then
    fail "Could not generate a code for $account"
  fi

  printf '%s\t%s\n' "$(tr -d '[:space:]' <<<"$code")" "$account"
}

cmd=${1:-info}

require_ykman

case "$cmd" in
# Exit status only: menu rows use this as a `when` guard.
present)
  key_present
  exit $?
  ;;

# Used by the bar widget after it draws from the cache.
refresh-cache)
  require_key
  refresh_cache || fail "Could not read the accounts on this key"
  ;;

status)
  if key_present; then
    notify "$(ykman list 2>/dev/null | head -n1 || echo "YubiKey connected")"
  else
    notify "No YubiKey detected — plug one in"
  fi
  ;;

info)
  terminal 'ykman info'
  ;;

# Scans a 2FA setup QR off the screen. omarchy-capture-qr puts the decoded
# value on the clipboard and nowhere else; we take it from there and clear it
# again, because that value is the secret itself.
add)
  require_key
  command -v omarchy-capture-qr >/dev/null || fail "omarchy-capture-qr is not available"

  clipboard_before=$(wl-paste --no-newline 2>/dev/null || true)
  scanned=""
  restore_clipboard() {
    [[ -n $scanned ]] || return 0
    [[ $(wl-paste --no-newline 2>/dev/null || true) == "$scanned" ]] || return 0
    if [[ -n $clipboard_before ]]; then
      printf '%s' "$clipboard_before" | wl-copy --sensitive
    else
      wl-copy --clear
    fi
  }
  # The decoded QR is the secret itself, so it goes back however this ends.
  trap restore_clipboard EXIT

  notify "Select the QR code on screen"
  omarchy-capture-qr >/dev/null 2>&1 || exit 0

  scanned=$(wl-paste --no-newline 2>/dev/null || true)
  [[ -n $scanned && $scanned != "$clipboard_before" ]] || fail "No QR code was captured"

  add_from_uri "$scanned"
  ;;

# Manual entry: the name is not secret and can come from a prompt, the secret
# is typed into a terminal where ykman hides it.
add-manual)
  require_key
  name=$(omarchy-menu-input "Account name, such as GitHub:you@example.com") || exit 0
  [[ -n $name ]] || exit 0
  terminal "read -rsp 'Base32 secret: ' secret && echo && printf '%s' \"\$secret\" | ykman oath accounts add -f $(printf '%q' "$name")"
  ;;

code)
  require_key
  result=$(pick_code "${2:-}") || exit 0
  code=${result%%$'\t'*}
  account=${result##*$'\t'}

  printf '%s' "$code" | wl-copy --sensitive

  # A one-time code has no business outliving its use.
  (
    sleep "$CLIPBOARD_TIMEOUT"
    [[ $(wl-paste --no-newline 2>/dev/null) == "$code" ]] && wl-copy --clear
  ) >/dev/null 2>&1 &

  # The code never goes in the notification body — Omarchy keeps the last ten
  # notifications on disk as plaintext, and notify-send argv is world-readable.
  notify "Code copied for $account — clears in ${CLIPBOARD_TIMEOUT}s"
  ;;

# Types the code straight into the field you were looking at, so it never
# touches the clipboard at all.
type)
  require_key
  command -v wtype >/dev/null || fail "wtype is not installed — use the clipboard action instead"

  # The picker takes focus, so remember the window to type back into.
  target=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // ""')

  result=$(pick_code "${2:-}") || exit 0
  code=${result%%$'\t'*}
  account=${result##*$'\t'}

  if [[ -n $target ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$target\" })" >/dev/null 2>&1 ||
      hyprctl dispatch focuswindow "address:$target" >/dev/null 2>&1
    sleep 0.25
  fi

  printf '%s' "$code" | wtype - || fail "Could not type the code for $account"
  notify "Typed a code for $account"
  ;;

accounts)
  terminal 'ykman oath accounts list'
  ;;

piv)
  terminal 'ykman piv info'
  ;;

fido)
  terminal 'ykman fido info'
  ;;

credentials)
  terminal 'ykman fido credentials list'
  ;;

openpgp)
  terminal 'ykman openpgp info'
  ;;

otp)
  terminal 'ykman otp info'
  ;;

# The usual cure when the card stops answering after a suspend or a re-plug.
reset-gpg)
  terminal 'gpgconf --kill scdaemon gpg-agent; gpg --card-status'
  ;;

smartcard)
  terminal 'sudo systemctl enable --now pcscd.socket; systemctl status pcscd.socket --no-pager'
  ;;

authenticator)
  omarchy-launch-or-focus authenticator 'uwsm-app -- /opt/yubico-authenticator/authenticator'
  ;;

*)
  echo "Usage: yubikey-menu <present|status|refresh-cache|info|add|add-manual|code [account]|type [account]|accounts|piv|fido|credentials|openpgp|otp|reset-gpg|smartcard|authenticator>" >&2
  exit 1
  ;;
esac
